# Hindsight server-level settings. Upstream reads these from env only (no config
# file); kustomize configMapGenerator turns this file into a hash-suffixed
# ConfigMap, so any edit here rolls the pod. Behavioural settings (missions,
# budgets, knowledge_page_default_trigger) are per bank, owned by homelab-platform
# agents/hindsight/*-bank-template.json and applied via /import.

# fixed id: default = pod hostname, new on recreate -> orphans async
# tasks. Safe at replicas=1.
HINDSIGHT_API_WORKER_ID=hindsight-0

# LLM via litellm (openai-compatible); routing in litellm DB. Aliases
# are named by role (hindsight-*), not by model: swapping the model
# behind one is a litellm-only change, no PR here.
# Key: HINDSIGHT_API_LLM_API_KEY (scoped virtual key, hindsight-auth).
HINDSIGHT_API_LLM_PROVIDER=openai

HINDSIGHT_API_LLM_BASE_URL=http://litellm.ai.svc.cluster.local:4000/v1

# alias pins think:false; thinking breaks JSON extraction
HINDSIGHT_API_LLM_MODEL=hindsight-retain

# same B580 weights as LLM_MODEL, thinking on (alias sets
# enable_thinking: true); no extra VRAM, no model swap.
HINDSIGHT_API_REFLECT_LLM_MODEL=hindsight-reflect

# worst call ~200s: 48k prefill at ~2k tok/s + ~8k thinking tokens
# at ~55 tok/s. (!) llama-server cancels only *streaming* requests on
# client disconnect; Hindsight's non-streaming calls keep generating
# after a timeout (measured: one ran to 48k tokens). The litellm
# alias's reasoning_budget_tokens (8192) is the runaway guard.
HINDSIGHT_API_REFLECT_LLM_TIMEOUT=300

# llama-server ctx 64k - ~12k thinking + answer - margin.
HINDSIGHT_API_REFLECT_MAX_CONTEXT_TOKENS=48000

# the think alias is one litellm slot (mpr=1); reflect's tool loop is
# sequential anyway.
HINDSIGHT_API_REFLECT_LLM_MAX_CONCURRENT=1

# Whole-task ceiling for reflect AND mental-model refresh: the worker
# maps refresh_mental_model onto reflect_wall_timeout, there is no
# separate refresh knob. 540 was sized for interactive reflect behind
# the 600s edge, but refreshes routinely took 450-545s (2026-10-16) and
# a broad page dies at the wall. Background calls go pod -> litellm
# svc -> llama-server, no edge in that path, so the wall only needs to
# catch a wedged task (a held permit, a hung connection), not pace a
# healthy one. Trade-off: an interactive reflect whose MCP client has
# already given up can now hold its own litellm slot for up to 1200s;
# its per-call REFLECT_LLM_TIMEOUT (300) and thinking budget still bound
# each call.
HINDSIGHT_API_REFLECT_WALL_TIMEOUT=1200

# Mental-model / knowledge-page refresh gets its own no-think lane
# (Hindsight docs: on a single-GPU box the background refresh wants a
# fast no-think model that cannot blow the wall timeout or starve
# interactive reflect). Own litellm alias = own in-flight slot, so a
# refresh no longer 429s interactive reflect. Measured 2026-10-16 on the
# thinking alias: a broad page built a 32k prompt and decoded to the
# 12288 cap in 363s (> 300s timeout), then retried to the 540s wall.
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MODEL=hindsight-refresh

# falls back to LLM_TIMEOUT (not REFLECT_LLM_TIMEOUT) when unset.
# A per-call timeout protects nothing here: llama-server keeps
# generating a timed-out non-streaming call, so cutting it only throws
# the work away while the slot stays busy, and the retry then 429s on
# the orphan (2026-10-16: a full-mode page refresh timed out at 300s and
# failed exactly this way). The real bound is the output cap
# (REFLECT_MAX_COMPLETION_TOKENS 12288, measured 363s at the cap) plus
# prefill, so ~8 min worst case; llama-server n-predict 16384 is the
# backstop. 900 sits above that: it only fires on a hung connection.
# (!) litellm's global request_timeout (600) cuts first unless the
# hindsight-refresh alias carries its own timeout >= 900 in the DB.
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_TIMEOUT=900

# process-wide: refresh tasks queue here instead of 429ing litellm
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MAX_CONCURRENT=1

# A retry after a *timeout* 429s on the still-generating orphan, but
# with the timeout above the output bound that case is gone. What is
# left are real transient errors (llama-server model reload, pod
# restart), where no orphan holds the slot and one retry succeeds.
# Keep 1: a failed refresh flags the page and blocks its cron until a
# manual refresh succeeds.
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MAX_RETRIES=1

# consolidation on the B580 with thinking capped at 2048 tokens
# (hindsight-consolidate). Consolidation benchmark, 12-fact batches:
# 31/32 scenarios clean vs 11/32 without thinking; budget 1024 = 25/32,
# unbudgeted ran away. Retain stays on hindsight-retain (no thinking).
HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=hindsight-consolidate

# ~60-115s per batch (2048 thinking + ~1.5k output, up to 16k prompt).
# Same reasoning as the refresh timeout: background work, the call is
# not cancelled upstream, so the timeout must sit above the output cap
# (CONSOLIDATION_MAX_COMPLETION_TOKENS 8192, ~240s alone, longer when
# both llama-server slots decode at once), not at the typical case.
# The task-level CONSOLIDATION_WALL_TIMEOUT (default 7200s, counted
# from the last progress) stays the wedge backstop.
# (!) needs a matching per-alias timeout on hindsight-consolidate in
# the litellm DB, or litellm's global 600s cuts first.
HINDSIGHT_API_CONSOLIDATION_LLM_TIMEOUT=900

# the alias is one litellm slot (mpr=1); inherited 2 -> self-inflicted 429s
HINDSIGHT_API_CONSOLIDATION_LLM_MAX_CONCURRENT=1

# Output caps = the runaway guard for non-streaming calls, which
# llama-server's router does not cancel on client disconnect
# (llama.cpp#29707, open). A request's max_tokens beats every server/
# litellm default, so the caps must come from the client. Counts
# include thinking tokens. Observed: extraction max 2855 (default
# 64000; overflow splits the chunk and retries), consolidation ~3.3k
# (2048 thinking budget), reflect synthesis ~7.3k (8192 budget).
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=8192

HINDSIGHT_API_CONSOLIDATION_MAX_COMPLETION_TOKENS=8192

HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=12288

# = llama-server slots (parallel = 2); default 32 just queues in
# litellm/llama-server and runs into the per-call timeout.
HINDSIGHT_API_LLM_MAX_CONCURRENT=2

# retain chunks that exhaust retries are lost. 429 (litellm mpr full)
# and a llama-server restart (model reload) both clear on retry;
# default 3 is too few for a reload.
HINDSIGHT_API_LLM_MAX_RETRIES=10

# CPU cross-encoder on 8-core arm64: default 4 concurrent x 8 torch
# threads thrashed -> 140-680s recalls, MCP timeouts. Serialize.
HINDSIGHT_API_RERANKER_LOCAL_MAX_CONCURRENT=1

# default 300; idle rerank 300=~19s, 100=~6s. RRF top-100 enough.
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=100

# length-sorted batches, less padding (upstream: 36-54% faster)
HINDSIGHT_API_RERANKER_LOCAL_BUCKET_BATCHING=true
