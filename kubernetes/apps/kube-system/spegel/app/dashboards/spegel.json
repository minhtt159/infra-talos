    {
      "type": "timeseries",
      "title": "Dial errors",
      "description": "Failed libp2p dials, by error.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
