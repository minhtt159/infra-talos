{
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "node",
        "label": "Node",
        "datasource": "${DS_PROMETHEUS}",
        "query": {
          "query": "label_values(up{job=\"spegel\", namespace=\"kube-system\"}, node)",
          "refId": "node"
        },
        "definition": "label_values(up{job=\"spegel\", namespace=\"kube-system\"}, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "title": "Spegel",
  "uid": "spegel",
  "description": "Spegel v0.8 P2P registry mirror: cache hits, registry traffic, DHT routing. Pod CPU/memory: the kubernetes mixin dashboards.",
  "tags": [
    "spegel",
    "registry",
    "kubernetes"
  ],
  "links": [
    {
      "title": "Spegel",
      "type": "link",
      "url": "https://spegel.dev",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Pods up",
      "description": "Spegel pods answering scrapes (one per node).",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(up{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Mirror requests served from a peer over the selected range. Misses fall back to the upstream registry.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 3,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no pulls"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(increase(spegel_mirror_requests_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", cache=\"hit\"}[$__range])) / sum(increase(spegel_mirror_requests_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"}[$__range]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Hits",
      "description": "Mirror requests served by a peer over the selected range.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 7,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(increase(spegel_mirror_requests_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", cache=\"hit\"}[$__range]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Misses",
      "description": "Mirror requests no peer could serve over the selected range.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(increase(spegel_mirror_requests_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", cache=\"miss\"}[$__range]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Since last hit",
      "description": "Time since any pod last served a mirror request from a peer (gauge stays 0 until the first hit).",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 13,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "never"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "time() - max(spegel_mirror_last_success_timestamp_seconds{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"} > 0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 6
    },
    {
      "type": "stat",
      "title": "Advertised keys",
      "description": "Content keys (image digests, layers, tags) advertised to the DHT, summed over pods.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 17,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(spegel_advertised_keys{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 7
    },
    {
      "type": "stat",
      "title": "Peer connections",
      "description": "Open libp2p connections, summed over pods (opened - closed).",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(libp2p_swarm_connections_opened_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"}) - sum(libp2p_swarm_connections_closed_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "id": 8
    },
    {
      "type": "row",
      "title": "Mirror",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Mirror requests",
      "description": "Requests containerd sent to Spegel, by cache result.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (cache) (rate(spegel_mirror_requests_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{cache}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Hit ratio by node",
      "description": "Share of mirror requests on each node served by a peer.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (node) (rate(spegel_mirror_requests_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", cache=\"hit\"}[$__rate_interval])) / sum by (node) (rate(spegel_mirror_requests_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{node}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Mirror requests by registry",
      "description": "Which upstream registries are being mirrored.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (registry, cache) (rate(spegel_mirror_requests_total{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{registry}} {{cache}}"
        }
      ],
      "id": 12
    },
    {
      "type": "row",
      "title": "Registry (/v2)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": [],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "description": "OCI distribution requests handled by the registry, by HTTP status.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (code) (rate(http_request_duration_seconds_count{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", handler=\"/v2/*\"}[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Request latency",
      "description": "GET /v2 latency (blob and manifest transfers dominate).",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", handler=\"/v2/*\", method=\"GET\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", handler=\"/v2/*\", method=\"GET\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", handler=\"/v2/*\", method=\"GET\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Bytes served",
      "description": "Response bytes written by each node's registry (peer-to-peer and to the local containerd).",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (node) (rate(http_response_size_bytes_sum{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", handler=\"/v2/*\"}[$__rate_interval]))",
          "legendFormat": "{{node}}"
        }
      ],
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "In-flight requests",
      "description": "Concurrent /v2 requests per node.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (node) (http_requests_inflight{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\", handler=\"/v2/*\"})",
          "legendFormat": "{{node}}"
        }
      ],
      "id": 17
    },
    {
      "type": "row",
      "title": "Router (libp2p)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": [],
      "id": 18
    },
    {
      "type": "timeseries",
      "title": "Resolve latency",
      "description": "Time for the DHT to find a peer holding the requested content.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
