          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(spegel_resolve_duration_seconds_bucket{job=\"spegel\", namespace=\"kube-system\", node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": "${DS_PROMETHEUS}",
